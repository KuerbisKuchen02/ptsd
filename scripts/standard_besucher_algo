RegisterFunction(
  [SetNextAttractionStandard],
  [Boolean],
  1,
  1,
  [
Do(
  EnterDebugger(),
  Var([atom_visitor], vbValue, p(1)),
  Var([hash_map], vbAtom, AtomDataContainer([attractions], atom_visitor)),
  Var([ran_val], vbValue, Random(100)),
  Var([t_curr], vBValue, DateTime([hhnnss])),
  {Var([t_leave], vbValue, Att([exitTime], atom_visitor)),}
  Var([t_leave], vbValue, 1000),
  
  if((t_curr > t_leave),
    (0),
    (if((AND((t_curr >= hr(11)), (t_curr <= hr(13)))),
      Var([p_eat], vbValue, 30),
      Var([p_eat], vbValue, 5)))),
        
  if((ran_val < p_eat),
    (setLabel([nextAttraction], -1, atom_visitor)),
      Do(
      Var([counter], vbValue, 2),
      Var([sum_popularity], vbValue, 0),
      Var([curr_attraction_id], vbValue, 0),
      Var([curr_probability], vbValue, 0),
      ran_val := Random(100),
      While((counter <=33), 
        Do(
          curr_attraction_id := ExcelActiveX_read(counter, 1),
          curr_probability := ExcelActiveX_read(counter, 11),
          sum_popularity := sum_popularity + curr_probability,
          if((sum_popularity > ran_val), 
              (Do(
                setLabel([nextAttraction], curr_attraction_id, atom_visitor),
                break
                )),
              ()
          ),
        inc(counter)
      ))
    ))
)
  ],
  [sets the nextAttraction attribute of the person who leaves an attraction],
  [SetNextAttractionStandard([ref_Visitor])],
  [public],
  [InControl Simulation Software]
)