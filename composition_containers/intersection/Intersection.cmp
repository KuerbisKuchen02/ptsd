{Atom: Intersection}

sets;
AtomByName([Composition Container], Main);
if(not(AtomExists), Error([Cannot find mother atom 'Composition Container'. Inheriting from BaseClass.]));
CreateAtom(a, s, [Intersection], 1, false);
SetAtt([openatscale], 17);
SetAtt([displaycontents], 1);
SetAtt([nrvariables], 0);
SetAtt([CheckContentInView], 2);
SetAtt([xCenter2D], -13);
SetAtt([yCenter2D], 41);
SetAtt([xRadius2D], 7);
SetAtt([yRadius2D], 6);
SetAtt([xCenter3D], 5.5);
SetAtt([yCenter3D], 5.5);
SetAtt([zCenter3D], 0.5);
SetAtt([Radius3D], 7.79422863405995);
SetAtt([ShowName], 0);
SetAtomSettings([], 8421504, 25650);
Set(Icon(a), 
	RegisterIcon(pDir([media\images\default.jpg]), [default]));
SetMaterial(
	RegisterMaterial([Default], 8421504, 8421504, 3289650, 0, 0.100000001490116, 0, false, false, 1, 0), 1, a);
Set(Version(a), 0);
SetTreeIcon(pDir([Media\Icons\CompositionContainer.ico]));
Set(DdbRec, [>atmname:C:\Temp\ptsd\composition_containers\intersection\Intersection.atm.>cmpname:C:\Temp\ptsd\composition_containers\intersection\Intersection.cmp.]);
SetChannels(1, 0);
SetChannelRanges(1, 255, 0, 0);
SetLoadAtomID(1);
SetLoc(-20, 35, 0);
SetSize(11, 11, 10);
LockPosition(false);
LockSize(false);
DisableIconRotation(false);
SetTable(1, 2);
CreateTableColumn(0, 25, [``
1
]);
CreateTableColumn(1, 100, [`VariableName`
]);
CreateTableColumn(2, 150, [`Expression`
]);
Set(OnCreation, [4DS[
             do(
              if(
               not(comparetext(name(c),[])),
               if(fileexists([C:\Temp\ptsd\composition_containers\intersection\Intersection.cmp]),
                execfile([C:\Temp\ptsd\composition_containers\intersection\Intersection.cmp]),
                msg(concat([Cannot locate:],lf,cr,[C:\Temp\ptsd\composition_containers\intersection\Intersection.cmp],lf,cr,[Make sure the *.CMP file is in the directory as stated above]))
               )
              ),
              set(oncreation(c),concat(sbo,[nothing],sbc))
             )
            ]4DS]);
