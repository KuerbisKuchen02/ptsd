{10.5.0.3374}


{Load required atoms}

StoreActiveAtom;
LoadAtomFromFile([Product], pDir([Atoms\BASIC MODELING\Product.atm]));
LoadAtomFromFile([Source], pDir([Atoms\BASIC MODELING\Source.atm]));
LoadAtomFromFile([Composition Container], pDir([Atoms\TOOLS\Composition Container.atm]));
LoadAtomFromFile([Accumulating Conveyor], pDir([Atoms\TRANSPORT\CONVEYORS\ACCUMULATING\Accumulating Conveyor.atm]));
RestoreActiveAtom;


{Atom: Entrance}

sets;
AtomByName([Composition Container], Main);
if(not(AtomExists), Error([Cannot find mother atom 'Composition Container'. Inheriting from BaseClass.]));
CreateAtom(a, s, [Entrance], 1, false);
SetAtt([openatscale], 17);
SetAtt([displaycontents], 1);
SetAtt([nrvariables], 0);
SetAtt([CheckContentInView], 2);
SetAtt([xCenter2D], 16.5);
SetAtt([yCenter2D], 4.5);
SetAtt([xRadius2D], 17.5);
SetAtt([yRadius2D], 1.5);
SetAtt([xCenter3D], 18.5);
SetAtt([yCenter3D], 2.5);
SetAtt([zCenter3D], 1);
SetAtt([Radius3D], 17.5926120857592);
SetAtt([ShowName], 0);
SetAtomSettings([], 8421504, 25650);
Set(Icon(a), 
	RegisterIcon(pDir([media\images\default.jpg]), [default]));
SetMaterial(
	RegisterMaterial([Default], 8421504, 8421504, 3289650, 0, 0.100000001490116, 0, false, false, 1, 0), 1, a);
Set(Version(a), 0);
SetTreeIcon(pDir([Media\Icons\CompositionContainer.ico]));
Set(DdbRec, [>cmpname:C:\temp\ptsd\composition_containers\entrance\Entrance.cmp.>atmname:C:\temp\ptsd\composition_containers\entrance\Entrance.atm.]);
SetChannels(1, 0);
SetChannelRanges(1, 255, 0, 0);
SetLoadAtomID(1);
SetSize(37, 5, 10);
LockPosition(false);
LockSize(false);
DisableIconRotation(false);
SetTable(1, 2);
CreateTableColumn(0, 25, [``
1
]);
CreateTableColumn(1, 100, [`VariableName`
]);
CreateTableColumn(2, 150, [`Expression`
]);
Set(OnCreation, [4DS[
             do(
              if(
               not(comparetext(name(c),[])),
               if(fileexists([C:\temp\ptsd\composition_containers\entrance\Entrance.cmp]),
                execfile([C:\temp\ptsd\composition_containers\entrance\Entrance.cmp]),
                msg(concat([Cannot locate:],lf,cr,[C:\temp\ptsd\composition_containers\entrance\Entrance.cmp],lf,cr,[Make sure the *.CMP file is in the directory as stated above]))
               )
              ),
              set(oncreation(c),concat(sbo,[nothing],sbc))
             )
            ]4DS]);
SetStatus(0);
ExecLateInit;


{Atom: Spawner}

sets;
AtomByName([Source], Main);
if(not(AtomExists), Error([Cannot find mother atom 'Source'. Inheriting from BaseClass.]));
CreateAtom(a, s, [Spawner], 1, false);
SetExprAtt([SendTo], [{.~1|~1~.}1]);
SetExprAtt([CycleTime], [10]);
SetExprAtt([CreationTrigger], [{.~1|~setEntryLabels2~.}setEntryLabels2]);
SetExprAtt([ExitTrigger], [0]);
SetExprAtt([FirstProduct], [10]);
SetExprAtt([MaxProducts], [{.-1|1. Unlimited.}-1]);
SetAtt([Icon3D], 4);
SetAtomSettings([], 255, 176);
Set(Icon(a), 
	RegisterIcon(IconsDir([bmp\atoms\source.bmp]), [source]));
AddModel3D(
	RegisterModel3D(Model3DDir([source.wrl]), [source.wrl], 0, 0, 0, 1, 1, -1, -90, 0, 0), a);
