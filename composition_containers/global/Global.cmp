  Att([flag], atmDistribution) := 0,
  Repeat(
    nRows(atmDistribution),
    if(
      att([flag], atmDistribution) = 0,
      if(
        att([randomnr], atmDistribution) < cell(count,1, atmDistribution),
        do(
