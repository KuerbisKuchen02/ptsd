{Atom: Function Editor43}

sets;
AtomByName([Function Editor], Main);
if(not(AtomExists), Error([Cannot find mother atom 'Function Editor'. Inheriting from BaseClass.]));
CreateAtom(a, Up(s), [Function Editor43], 1, false);
CreateAttributes(3);
SetAttributeName(r(1), [search_Att], a);
SetAttributeName(r(2), [indexPOI_Att], a);
SetAttributeName(r(3), [nextAttraction_Att], a);
SetAttribute(r(1), [search_Att], vbVariant, [4DS[{c is the atom calling the function}
{i is the guest}

Do(
  EnterDebugger(),
  
  {Cleanup previous data}
  If(AtomDataContainer([visited], c) > 0, AtomDataContainerDelete([visited], c)),
  IF(AtomDataContainer([queue], c) > 0, AtomDataContainerDelete([queue], c)),
  
  Var([target], vbValue, Label([nextAttraction], First(c))),
  Assert(target <= 0),
  Trace([Target ID: ], target),
  {Find the atom ref for the given target or stop if the target is not defined}
  Var([pois], vbValue, AtomDataContainer([pois], Model)),
  Var([targetRef], vbAtom),
  If(Not(HashMapTryGetValue(pois, target, targetRef)), Do(
    Trace([Error while routing guest! Target = '], target, [' is not a valid POI. Is the id of the POI set correctly and was the POI index successful?]),
    Stop(),
    Return()
  )),
  
  {breath search}
  Var([visitedRef], vbValue, HashMapCreate(c, [visited], vbAtom, vbValue)),
  Var([queueRef], vbValue, VectorCreate(c, [queue], vbAtom)),
  Var([node], vbAtom),
  Var([child], vbAtom),
  Var([channel], vbValue, -1),
  
  VectorAdd(queueRef, c),
  HashMapAdd(visitedRef, c, -1),
  
  While(VectorSize(queueRef) <> 0, Do(
    node := VectorItem(queueRef, 0),
    VectorDelete(queueRef, 0),
    
    If(Up(node) = targetRef, Do(
      channel := HashMapItem(visitedRef, node),
      Trace([Found target, use channel ], channel),
      Break
    )),
    
    Repeat(NrOC(node), Do(
      If(Not(OcConnected(Count, node)), Continue),
      child := Out(Count, node),
      
      {Make sure pathfinding is only done through conveyors}
      if(AttExists([isConveyor]) = 0, child, do(
        Msg(Concat([No path to the target: ], String(target))),
        Stop,
        Return
      )),
            
      If(HashMapContainsKey(visitedRef, child), Continue),
      VectorAdd(queueRef, child),
      
      channel := HashMapItem(visitedRef, node),
      If(channel = -1, 
        HashMapAdd(visitedRef, child, Count),
        HashMapAdd(visitedRef, child, channel)
      )  
    ))
  )),
  {Cleanup}
  HashMapDestroy(visitedRef),
  VectorDestroy(queueRef),
  
  If(channel < 0, 
    Trace([Found no valid route to target ], Name(targetRef), [ (internal id: ], targetRef, [ id: ], target, [)])
  ),
  Return(channel)
)
]4DS], a, [public], [], false);
SetAttribute(r(2), [indexPOI_Att], vbVariant, [4DS[Do(
  
  {Store all point of interests in the root atom 'Model'}
  AtomDataContainerDelete([pois], Model),
  Var([pois], vbValue, HashMapCreate(Model, [pois], vbValue, vbAtom)),
  
  Var([temp], vbValue),
  ForAtomTreeUnder(Model,
    Do(
      temp := Value(TableFindString(a, [id], 1, 2)),
      If(temp > 0, Do(
        {Test if id is defined multiple times and then throw an error}
        If(HashMapContainsKey(pois, temp), Do(
          Trace([Id '], temp, [' in container '], Name(a), [ (], a, [)' >]),
          Trace([  already exists in container '], Name(HashMapItem(pois, temp)), [']),
          Msg(Concat([Error while indexing POIs: Id '], String(temp), [' is defined multiple times!])),
          Return()
        )), 
        HashMapAdd(pois, temp, a)
      ))
    )
  ),
  Trace([Index successful: Found ], HashMapSize(pois), [ POIs])
)

]4DS], a, [public], [], false);
SetAttribute(r(3), [nextAttraction_Att], vbVariant, [4DS[Do(
  Var([dest], vbValue, AttractionRating),
  SetLabel([nextAttraction], dest, i),
  If(dest = 7, Color(i) := ColorBlack),
  If(dest = 1, Color(i) := ColorRed),
  If(dest = 2, Color(i) := ColorBlue),
  If(dest = 3, Color(i) := ColorGreen),
  If(dest = 4, Color(i) := ColorYellow),
  If(dest = 5, Color(i) := ColorOrange),
  If(dest = 6, Color(i) := ColorBrown)
)]4DS], a, [public], [], false);
SetAtomSettings([], 33023, 1192);
DefineFunction([nextAttraction], [Various], 0, 0, [4DS[Do(
  Var([dest], vbValue, AttractionRating),
  SetLabel([nextAttraction], dest, i),
  If(dest = 7, Color(i) := ColorBlack),
  If(dest = 1, Color(i) := ColorRed),
  If(dest = 2, Color(i) := ColorBlue),
  If(dest = 3, Color(i) := ColorGreen),
  If(dest = 4, Color(i) := ColorYellow),
  If(dest = 5, Color(i) := ColorOrange),
  If(dest = 6, Color(i) := ColorBrown)
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([indexPOI], [Various], 0, 0, [4DS[Do(
  
  {Store all point of interests in the root atom 'Model'}
  AtomDataContainerDelete([pois], Model),
  Var([pois], vbValue, HashMapCreate(Model, [pois], vbValue, vbAtom)),
  
  Var([temp], vbValue),
  ForAtomTreeUnder(Model,
    Do(
      temp := Value(TableFindString(a, [id], 1, 2)),
      If(temp > 0, Do(
        {Test if id is defined multiple times and then throw an error}
        If(HashMapContainsKey(pois, temp), Do(
          Trace([Id '], temp, [' in container '], Name(a), [ (], a, [)' >]),
          Trace([  already exists in container '], Name(HashMapItem(pois, temp)), [']),
          Msg(Concat([Error while indexing POIs: Id '], String(temp), [' is defined multiple times!])),
          Return()
        )), 
        HashMapAdd(pois, temp, a)
      ))
    )
  ),
  Trace([Index successful: Found ], HashMapSize(pois), [ POIs])
)

]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
