                  if(VectorAny(chosen_attractions_vector, curr_attraction_id), continue),
                  { Valid Attraction found, set Label and destroy Temp List }
                  VectorDestroy(chosen_attractions_vector),
                  setLabel([nextAttraction], curr_attraction_id, atom_visitor),
                  trace([f]),
                  trace(curr_attraction_id),
                  return
                  )),
                ()
            )
        ))
      )))
    )))
]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([getExitTime], [Various], 0, 0, [4DS[Do(
  EnterDebugger,
  
  Var(
    [exitTime],
    vbValue,
    Round(
      Time - Mod(Time, hr(24)) +
      hr(
        if(
          CompareText(schedule, [Normal]),
          18 - Abs(Normal(0, 2)),
          if(
            CompareText(schedule, [LongHour]),
            19 - Abs(Normal(0, 2)),
            if(
              CompareText(schedule, [Winter]),
              20 - Abs(Normal(0, 2)),
              Time
            )
          )
        )
      )
    )
  ),
    
  exitTime
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
