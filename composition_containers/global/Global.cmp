  ),

  If(ageParam = 65,
    ageParam := DUniform(60,69)
  ),

  If(ageParam = 75,
    ageParam := DUniform(70,79)
  ),

  Return(ageParam)
)]4DS], a, [public], [], false);
SetAttribute(r(7), [getAttractions_Att], vbVariant, [4DS[Do(
  Var(
    [attractionsRef],
    vbValue,
    HashMapCreate(i, [attractions], vbValue, vbValue)
  ),

  Repeat(
    nRows(model),
    Do(
      Var([attractionId], vbValue, CellAsValue(Count, 0, model)),

      If(
        Or(
          Label([age], i) < CellAsValue(Count, 11, model),
          Label([height], i) < CellAsValue(Count, 12, model),
          Label([height], i) > CellAsValue(Count, 13, model)
        ),
        HashMapAdd(attractionsRef, attractionId, -1),
        HashMapAdd(attractionsRef, attractionId, 0)
      )
    )
  )
)]4DS], a, [public], [], false);
SetAttribute(r(8), [setEntryLabels2_Att], vbVariant, [4DS[Do(
  SetLabel([hasFastPass], fastPass, i),
  SetLabel([entryTime], Time, i),
  SetLabel([exitTime], getExitTime, i),
  SetLabel([age], getAge, i),
  SetLabel([height], getHeight(Label([age], i)), i),
  SetLabel([entranceId], Value(TableFindString(up(c), [id], 1, 2)), i),
  getAttractions
)]4DS], a, [public], [], false);
SetAttribute(r(9), [setTrainCapacities_Att], vbVariant, [4DS[Do(
  EnterDebugger,
  Var([poiRef], vbValue, AtomDataContainer([pois], Model)),
  Var([id], vbValue),
  Var([attractionRef], vbAtom),
  Var([entryRef], vbAtom),
  Repeat(nRows(Model), Do(
    id := CellAsValue(Count, 0, Model),
    If(HashMapTryGetValue(poiRef, id, attractionRef), Do(
      entryRef := AtomByName([EntryStation], attractionRef),
      Cell(2, 1, entryRef) := CellAsValue(Count, 4, Model)
    ))
  ))
)]4DS], a, [public], [], false);
SetAttribute(r(10), [setNextAttraction_Att], vbVariant, [4DS[Do(
  EnterDebugger(),
  trace([a]),
  Var([atom_visitor], vbValue, p(1)),
  Var([hash_map], vbAtom, AtomDataContainer([attractions], atom_visitor)),
  Var([ran_val], vbValue, Random(100)),
  Var([t_curr], vBValue, DateTime([hhnnss])),
  Var([t_leave], vbValue, Att([exitTime], atom_visitor)),
  Var([t_leave], vbValue, 1000),
  
  { Check if the visitor planned to leave the park based on the current time, if not set the probabilities of eating or attraction based on the daytime}
  if((t_curr > t_leave),
    (setLabel([NextAttraction], 0)),
    (if((AND((t_curr >= hr(11)), (t_curr <= hr(13)))),
      Var([p_eat], vbValue, 30),
      Var([p_eat], vbValue, 5)))),
  trace([b]),
  trace(ran_val),
  trace(p_eat),    
  { Visitor wants to do an attraction, get the next attraction based on popularity of the attractions }      
  if((ran_val < p_eat),
    (setLabel([nextAttraction], -1, atom_visitor)),
      Do(
      Var([sum_popularity], vbValue, 0),
      Var([curr_attraction_id], vbValue, 0),
      Var([curr_probability], vbValue, 0),
      Var([chosen_attractions_vector], vbValue, VectorCreate(atom_visitor, [temp], vbValue)),   { Used to temporarily save attractions which got pulled by random chance, when it already got visited at least once by the user }
      While((1),
      (Do(
        trace([c]),
        ran_val := Random(100),
        Repeat(NRows(model), 
          Do(
            trace([d]),
            curr_attraction_id := CellAsValue(count, 0, model),
            curr_probability := CellAsValue(count, 10, model),
            trace(curr_attraction_id),
            trace(curr_probability),
            sum_popularity := sum_popularity + curr_probability,
            if((sum_popularity > ran_val), 
                (Do(
                  trace([e]),
                  { Check if visitor can visited this attraction }
                  if((), continue),
                  { Check if visitor already visited this attraction and if so check again if it was pulled once and is therefore in the temp list }
                  if(VectorAny(chosen_attractions_vector, curr_attraction_id), continue),
                  { Valid Attraction found, set Label and destroy Temp List }
                  VectorDestroy(chosen_attractions_vector),
                  setLabel([nextAttraction], curr_attraction_id, atom_visitor),
                  trace([f]),
                  trace(curr_attraction_id),
                  return
                  )),
                ()
            )
        ))
      )))
    )))
]4DS], a, [public], [], false);
SetAttribute(r(11), [search_Att], vbVariant, [4DS[{c is the atom calling the function}
{i is the guest}

Do(
  EnterDebugger(),
  
  {Cleanup previous data}
  If(AtomDataContainer([visited], c) > 0, AtomDataContainerDelete([visited], c)),
  IF(AtomDataContainer([queue], c) > 0, AtomDataContainerDelete([queue], c)),
  
  Var([target], vbValue, Label([nextAttraction], First(c))),
  Assert(target <= 0),
  Trace([Target ID: ], target),
  {Find the atom ref for the given target or stop if the target is not defined}
  Var([pois], vbValue, AtomDataContainer([pois], Model)),
  Var([targetRef], vbAtom),
  If(Not(HashMapTryGetValue(pois, target, targetRef)), Do(
    Trace([Error while routing guest! Target = '], target, [' is not a valid POI. Is the id of the POI set correctly and was the POI index successful?]),
    Stop(),
    Return()
  )),
  
  {breath search}
  Var([visitedRef], vbValue, HashMapCreate(c, [visited], vbAtom, vbValue)),
  Var([queueRef], vbValue, VectorCreate(c, [queue], vbAtom)),
  Var([node], vbAtom),
  Var([child], vbAtom),
  Var([channel], vbValue, -1),
  
  VectorAdd(queueRef, c),
  HashMapAdd(visitedRef, c, -1),
  
  While(VectorSize(queueRef) <> 0, Do(
    node := VectorItem(queueRef, 0),
    VectorDelete(queueRef, 0),
    
    If(Up(node) = targetRef, Do(
      channel := HashMapItem(visitedRef, node),
      Trace([Found target, use channel ], channel),
      Break
    )),
    
    Repeat(NrOC(node), Do(
      If(Not(OcConnected(Count, node)), Continue),
      child := Out(Count, node),
      
      {Make sure pathfinding is only done through conveyors}
      if(AttExists([isConveyor]) = 0, child, do(
        Msg(Concat([No path to the target: ], String(target))),
        Stop,
        Return
      )),
            
      If(HashMapContainsKey(visitedRef, child), Continue),
      VectorAdd(queueRef, child),
      
      channel := HashMapItem(visitedRef, node),
      If(channel = -1, 
        HashMapAdd(visitedRef, child, Count),
        HashMapAdd(visitedRef, child, channel)
      )  
    ))
  )),
  {Cleanup}
  HashMapDestroy(visitedRef),
  VectorDestroy(queueRef),
  
  If(channel < 0, 
    Trace([Found no valid route to target ], Name(targetRef), [ (internal id: ], targetRef, [ id: ], target, [)])
  ),
  Return(channel)
)]4DS], a, [public], [], false);
SetAttribute(r(12), [unpack_Att], vbVariant, [4DS[{Don't use a debugger or at least don't step over FromAtomLayerUnder or step into the next iteration of the function.
This will likely break everything!}
Do(
  Var([parent], vbAtom),
  Var([child], vbAtom),
  Var([numberOfChilds], vbValue),
  
  ForAtomLayerUnder(Model, Do(
    Assert(a = 0, Do(
      Trace([You're probably using a debugger. Stop debugging to be able to run this function!]),
      Stop,
      Return
    )),
      
    {Check if the active atom is (probably) a composition container}
    If(StringMatchesMask(TreeIcon(a),[*CompositionContainer*]), Do(
      parent := a,
      numberOfChilds := 0,
      ForAtomLayerUnder(parent, Do(
        Assert(a = parent, Do(
          Trace([You're probably using a debugger. Stop debugging to be able to run this function!]),
          Stop,
          Return
        )),
        child := a,
        Inc(numberOfChilds)
      )),
      {When the parent container only contains a single composition container unpack this container and remove the parent}
      If(And(numberOfChilds = 1, StringMatchesMask(TreeIcon(child),[*CompositionContainer*])), Do(
        Trace([Found composition container with single child container: ], Name(child), [ (], child, [)]),
        MoveAtom(child, Model, 1),
        Name(child) := Concat(Name(child), String(TableFindString(child, [id], 1, 2))),
        SetLoc(
          xAbsLoc(parent, Model),
          yAbsLoc(parent, Model),
          zAbsLoc(parent, Model),
          child
        ),
        DestroyAtom(parent)
      ))
    ))
  ))
)]4DS], a, [public], [], false);
