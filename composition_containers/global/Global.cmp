SetAttribute(r(1), [getExitTime_Att], vbVariant, [4DS[Round(
  Time - Mod(Time, hr(24)) +
  hr(
    if(
      CompareText(schedule, [Normal]),
      18 - Abs(Normal(0, 2)),
      if(
        CompareText(schedule, [LongHour]),
        19 - Abs(Normal(0, 2)),
        if(
          CompareText(schedule, [Winter]),
          20 - Abs(Normal(0, 2)),
          0
        )
      )
    )
  )
)
]4DS], a, [public], [], false);
SetAttribute(r(2), [indexPOI_Att], vbVariant, [4DS[Do(
  
  {Store all point of interests in the root atom 'Model'}
  AtomDataContainerDelete([pois], Model),
  Var([pois], vbValue, HashMapCreate(Model, [pois], vbValue, vbAtom)),
  
  Var([temp], vbValue),
  ForAtomTreeUnder(Model,
    Do(
      temp := Value(TableFindString(a, [id], 1, 2)),
      If(temp > 0, Do(
        {Test if id is defined multiple times and then throw an error}
        If(HashMapContainsKey(pois, temp), Do(
          Trace([Id '], temp, [' in container '], Name(a), [ (], a, [)' >]),
          Trace([  already exists in container '], Name(HashMapItem(pois, temp)), [']),
          Msg(Concat([Error while indexing POIs: Id '], String(temp), [' is defined multiple times!])),
          Return()
        )), 
        HashMapAdd(pois, temp, a)
      ))
    )
  ),
  Trace([Index successful: Found ], HashMapSize(pois), [ POIs])
)

]4DS], a, [public], [], false);
SetAttribute(r(3), [initilize_Att], vbVariant, [4DS[Do(
  ReadTableFromFile(Model, [C:\Temp\ptsd\data\ptsd.csv], [;]),
  indexPOI,
  dim([schedule], vbString, [LongHour]),
  connectSchedule
)]4DS], a, [public], [], false);
SetAttribute(r(4), [getHeight_Att], vbVariant, [4DS[do(
  var([ageParam], vbValue, p(1)),
  var([row], vbValue),
  var([meanHeight], vbValue),

  if(ageParam <= 18,
    row := ageParam + 2,
    if(ageParam <= 29,
      row := 21,
      if(ageParam <= 39,
        row := 22,
        if(ageParam <= 49,
          row := 23,
          if(ageParam <= 59,
            row := 24,
            if(ageParam <= 69,
              row := 25,
              row := 26
            )
          )
        )
      )
    )
  ),

  meanHeight := ExcelActiveX_Read(row, 2),

  Return(Round(Normal(meanHeight, 3)))
)]4DS], a, [public], [], false);
SetAttribute(r(5), [connectSchedule_Att], vbVariant, [4DS[do(
  if(
    CompareText(Label([Schedule], Model), [Normal]),

    Connect(
      1,
      AtomByName([NormalParkOpenSchedule], Model),
      1,
      AtomByName([Availability Control10], Model)
    ),

    if(
      CompareText(Label([Schedule], Model), [LongHour]),

      Connect(
        1,
        AtomByName([LongHourParkOpenSchedule], Model),
        1,
        AtomByName([Availability Control10], Model)
      ),

      if(
        CompareText(Label([Schedule], Model), [Winter]),

        Connect(
          1,
          AtomByName([WinterParkOpenSchedule], Model),
          1,
          AtomByName([Availability Control10], Model)
        )
      )
    )
  )
)
]4DS], a, [public], [], false);
SetAttribute(r(6), [getAge_Att], vbVariant, [4DS[Do(
  EnterDebugger,  

  var([ageParam], vbValue, age2),

  If(ageParam = 25,
    ageParam := DUniform(19,29)
  ),

  If(ageParam = 35,
    ageParam := DUniform(30,39)
  ),

  If(ageParam = 45,
    ageParam := DUniform(40,49)
  ),

  If(ageParam = 55,
    ageParam := DUniform(50,59)
  ),

  If(ageParam = 65,
    ageParam := DUniform(60,69)
  ),

  If(ageParam = 75,
    ageParam := DUniform(70,79)
  ),

  Return(ageParam)
)]4DS], a, [public], [], false);
SetAttribute(r(7), [getAttractions_Att], vbVariant, 0, a, [public], [], false);
SetAttribute(r(8), [setEntryLabels2_Att], vbVariant, [4DS[Do(
  SetLabel([hasFastPass], fastPass, i),
  SetLabel([entryTime], Time, i),
  SetLabel([existTime], getExitTime, i),
  SetLabel([age], getAge, i),
  SetLabel([height], getHeight(Label([age], i)), i)
