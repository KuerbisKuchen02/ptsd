  ReadTableFromFile(Model, [C:\Temp\ptsd\data\ptsd.csv], [;]),
  ReadTableFromFile(AtomByName([Initialize], Model), [C:\Temp\ptsd\data\heights.csv], [;]),
  indexPOI,
  dim([schedule], vbString, [LongHour]),
  connectSchedule,
  setTrainCapacities
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([getHeight], [Various], 1, 1, [4DS[do(
  var([ageParam], vbValue, p(1)),
  var([row], vbValue),
  var([meanHeight], vbValue),

  if(ageParam <= 18,
    row := ageParam + 1,
    if(ageParam <= 29,
      row := 20,
      if(ageParam <= 39,
        row := 21,
        if(ageParam <= 49,
          row := 22,
          if(ageParam <= 59,
            row := 23,
            if(ageParam <= 69,
              row := 24,
              row := 25
            )
          )
        )
      )
    )
  ),

  meanHeight := CellAsValue(row, 1, AtomByName([Initialize], Model)),

  Round(Normal(meanHeight, 3))
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([search], [Various], 3, 3, [4DS[{c is the atom calling the function}
{i is the guest}

Do(
  EnterDebugger(),
  
  {Cleanup previous data}
  If(AtomDataContainer([visited], c) > 0, AtomDataContainerDelete([visited], c)),
  IF(AtomDataContainer([queue], c) > 0, AtomDataContainerDelete([queue], c)),
  
  Var([target], vbValue, Label([nextAttraction], First(c))),
  Assert(target <= 0),
  Trace([Target ID: ], target),
  {Find the atom ref for the given target or stop if the target is not defined}
  Var([pois], vbValue, AtomDataContainer([pois], Model)),
  Var([targetRef], vbAtom),
  If(Not(HashMapTryGetValue(pois, target, targetRef)), Do(
    Trace([Error while routing guest! Target = '], target, [' is not a valid POI. Is the id of the POI set correctly and was the POI index successful?]),
    Stop(),
    Return()
  )),
  
  {breath search}
  Var([visitedRef], vbValue, HashMapCreate(c, [visited], vbAtom, vbValue)),
  Var([queueRef], vbValue, VectorCreate(c, [queue], vbAtom)),
  Var([node], vbAtom),
  Var([child], vbAtom),
  Var([channel], vbValue, -1),
  
  VectorAdd(queueRef, c),
  HashMapAdd(visitedRef, c, -1),
  
  While(VectorSize(queueRef) <> 0, Do(
    node := VectorItem(queueRef, 0),
    VectorDelete(queueRef, 0),
    
    If(Up(node) = targetRef, Do(
      channel := HashMapItem(visitedRef, node),
      Trace([Found target, use channel ], channel),
      Break
    )),
    
    Repeat(NrOC(node), Do(
      If(Not(OcConnected(Count, node)), Continue),
      child := Out(Count, node),
      
      {Make sure pathfinding is only done through conveyors}
      if(AttExists([isConveyor]) = 0, child, do(
        Msg(Concat([No path to the target: ], String(target))),
        Stop,
        Return
      )),
            
      If(HashMapContainsKey(visitedRef, child), Continue),
      VectorAdd(queueRef, child),
      
      channel := HashMapItem(visitedRef, node),
      If(channel = -1, 
        HashMapAdd(visitedRef, child, Count),
        HashMapAdd(visitedRef, child, channel)
      )  
    ))
  )),
  {Cleanup}
  HashMapDestroy(visitedRef),
  VectorDestroy(queueRef),
  
  If(channel < 0, 
    Trace([Found no valid route to target ], Name(targetRef), [ (internal id: ], targetRef, [ id: ], target, [)])
  ),
  Return(channel)
)]4DS], [], [], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([setEntryLabels2], [Various], 0, 0, [4DS[Do(
  SetLabel([hasFastPass], fastPass, i),
  SetLabel([entryTime], Time, i),
  SetLabel([exitTime], getExitTime, i),
  SetLabel([age], getAge, i),
  SetLabel([height], getHeight(Label([age], i)), i),
  SetLabel([entranceId], Value(TableFindString(up(c), [id], 1, 2)), i),
  getAttractions
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([unpack], [Various], 0, 0, [4DS[{Don't use a debugger or at least don't step over FromAtomLayerUnder or step into the next iteration of the function.
This will likely break everything!}
Do(
  Var([parent], vbAtom),
  Var([child], vbAtom),
  Var([numberOfChilds], vbValue),
  
  ForAtomLayerUnder(Model, Do(
    Assert(a = 0, Do(
      Trace([You're probably using a debugger. Stop debugging to be able to run this function!]),
      Stop,
      Return
    )),
      
    {Check if the active atom is (probably) a composition container}
    If(StringMatchesMask(TreeIcon(a),[*CompositionContainer*]), Do(
      parent := a,
      numberOfChilds := 0,
      ForAtomLayerUnder(parent, Do(
        Assert(a = parent, Do(
          Trace([You're probably using a debugger. Stop debugging to be able to run this function!]),
          Stop,
          Return
        )),
        child := a,
        Inc(numberOfChilds)
      )),
      {When the parent container only contains a single composition container unpack this container and remove the parent}
      If(And(numberOfChilds = 1, StringMatchesMask(TreeIcon(child),[*CompositionContainer*])), Do(
        Trace([Found composition container with single child container: ], Name(child), [ (], child, [)]),
        MoveAtom(child, Model, 1),
        Name(child) := Concat(Name(child), String(TableFindString(child, [id], 1, 2))),
        SetLoc(
          xAbsLoc(parent, Model),
          yAbsLoc(parent, Model),
          zAbsLoc(parent, Model),
          child
        ),
        DestroyAtom(parent)
      ))
    ))
  ))
)]4DS], [Unpack nested composition containers. WARNING: This command makes irreversible changes to the model tree. Save model before use!], [], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([indexPOI], [Various], 0, 0, [4DS[Do(
  
  {Store all point of interests in the root atom 'Model'}
  AtomDataContainerDelete([pois], Model),
  Var([pois], vbValue, HashMapCreate(Model, [pois], vbValue, vbAtom)),
  
  Var([temp], vbValue),
  ForAtomTreeUnder(Model,
    Do(
      temp := Value(TableFindString(a, [id], 1, 2)),
      If(temp > 0, Do(
        {Test if id is defined multiple times and then throw an error}
        If(HashMapContainsKey(pois, temp), Do(
          Trace([Id '], temp, [' in container '], Name(a), [ (], a, [)' >]),
          Trace([  already exists in container '], Name(HashMapItem(pois, temp)), [']),
          Msg(Concat([Error while indexing POIs: Id '], String(temp), [' is defined multiple times!])),
          Return()
        )), 
        HashMapAdd(pois, temp, a)
      ))
    )
  ),
  Trace([Index successful: Found ], HashMapSize(pois), [ POIs])
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
DefineFunction([setTrainCapacities], [Various], 0, 0, [4DS[Do(
  EnterDebugger,
  Var([poiRef], vbValue, AtomDataContainer([pois], Model)),
  Var([id], vbValue),
  Var([attractionRef], vbAtom),
  Var([entryRef], vbAtom),
  Repeat(nRows(Model), Do(
    id := CellAsValue(Count, 0, Model),
    If(HashMapTryGetValue(poiRef, id, attractionRef), Do(
      entryRef := AtomByName([EntryStation], attractionRef),
      Cell(2, 1, entryRef) := CellAsValue(Count, 4, Model)
    ))
  ))
)]4DS], [0], [0], [public], [Function Editor43], a, 0, vbVariant, []);
