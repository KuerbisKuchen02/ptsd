{Load required atoms}

StoreActiveAtom;
LoadAtomFromFile([Composition Container], pDir([Atoms\TOOLS\Composition Container.atm]));
LoadAtomFromFile([Function Editor], pDir([Atoms\TOOLS\Function Editor.atm]));
LoadAtomFromFile([Initialize], pDir([Atoms\TOOLS\Initialize.atm]));
RestoreActiveAtom;


{Preregister 4DS}

PreregisterFunction([nextAttraction], 0, 0);
PreregisterFunction([indexPOI], 0, 0);
PreregisterFunction([search], 0, 0);


{Atom: Global}

sets;
AtomByName([Composition Container], Main);
