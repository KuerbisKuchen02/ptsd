               if(fileexists([C:\temp\ptsd\composition_containers\global\Global.cmp]),
                execfile([C:\temp\ptsd\composition_containers\global\Global.cmp]),
                msg(concat([Cannot locate:],lf,cr,[C:\temp\ptsd\composition_containers\global\Global.cmp],lf,cr,[Make sure the *.CMP file is in the directory as stated above]))
               )
              ),
              set(oncreation(c),concat(sbo,[nothing],sbc))
             )
            ]4DS]);
SetStatus(0);
